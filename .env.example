# Copy to .dev.vars for local Wrangler, or set in Cloudflare Pages → Settings → Environment variables

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth redirect — must match Google Cloud Console authorized redirect URIs
# Local:  http://localhost:8788/api/auth/callback
# Prod:   https://your-pages-domain.pages.dev/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8788/api/auth/callback

# GSC property URL (URL-encoded in API calls), e.g. sc-domain:example.com or https://www.example.com/
GSC_SITE_URL=sc-domain:example.com

# Comma-separated branded terms (matched as regex OR group against search queries)
BRANDED_KEYWORDS=your brand,brand name,yourbrand

# Optional: encrypt session cookies (32+ random chars). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# TikTok (optional — stub returns sample data until configured)
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
