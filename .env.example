# Copy to .dev.vars for local Wrangler, or set in Cloudflare Pages → Settings → Environment variables

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# OAuth redirect — must match Google Cloud Console authorized redirect URIs
# Local:  http://localhost:8788/api/auth/callback
# Prod:   https://your-pages-domain.pages.dev/api/auth/callback
OAUTH_REDIRECT_URI=http://localhost:8788/api/auth/callback

# GSC property URL (URL-encoded in API calls), e.g. sc-domain:example.com or https://www.example.com/
GSC_SITE_URL=sc-domain:example.com

# Legacy single list (optional). Keep short; large lists should use BUSINESS_UNIT_KEYWORDS_JSON.
BRANDED_KEYWORDS=your brand,brand name,yourbrand

# Preferred: JSON map of business unit -> keyword list.
# Example:
# BUSINESS_UNIT_KEYWORDS_JSON={"all":["your brand","brand name"],"consumer":["consumer brand"],"enterprise":["enterprise product"]}
BUSINESS_UNIT_KEYWORDS_JSON={"all":["your brand","brand name"]}

# Optional: encrypt session cookies (32+ random chars). Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# TikTok Login Kit (optional — demo data until configured)
# From TikTok for Developers → your app → Sandbox credentials
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# Must exactly match the redirect URI in your TikTok app Login Kit settings
# TIKTOK_OAUTH_REDIRECT_URI=https://gscbranded.pages.dev/api/tiktok/callback
# After visiting /api/tiktok/oauth and approving as the Target User, paste values from the callback JSON:
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_REFRESH_TOKEN=
# TIKTOK_OPEN_ID=
# Fallback only, ignored once a TIKTOK_FOLLOWERS_KV binding exists (see README "Daily follower
# snapshots"). Optional URL to a static JSON file containing historical TikTok follower counts.
# Defaults to /tiktok-followers.json when built and deployed.
# TIKTOK_FOLLOWER_HISTORY_URL=/tiktok-followers.json
# Shared secret required (as X-Snapshot-Secret header) to call POST /api/tiktok/snapshot,
# which records today's live follower count into the TIKTOK_FOLLOWERS_KV namespace.
# Generate with: openssl rand -hex 32
# TIKTOK_SNAPSHOT_SECRET=
# Optional custom analytics proxy (overrides built-in TikTok API fetch)
# TIKTOK_ANALYTICS_ENDPOINT=

# Note: TIKTOK_FOLLOWERS_KV is a Cloudflare KV binding, not an env var — it can't be set here.
# For local dev with `wrangler pages dev`, add a KV binding via the CLI flag, e.g.:
#   wrangler pages dev dist --kv=TIKTOK_FOLLOWERS_KV --compatibility-date=2024-09-23
