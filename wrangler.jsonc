{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/templates/wrangler.schema.json",
  "name": "gscbranded-tiktok-history",
  "main": "workers/tiktok-history-updater.ts",
  "compatibility_date": "2024-09-23",
  "kv_namespaces": [
    {
      "binding": "TIKTOK_HISTORY_KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
